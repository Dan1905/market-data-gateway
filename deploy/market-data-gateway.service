# systemd unit that brings the compose stack up on boot.
#
# Install on the EC2 instance:
#   sudo cp deploy/market-data-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now market-data-gateway
#
# Then:  systemctl status market-data-gateway
#        journalctl -u market-data-gateway -f

[Unit]
Description=Market Data Gateway (docker compose stack)
Documentation=https://github.com/your-org/market-data-gateway
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Adjust to wherever you cloned the repository.
WorkingDirectory=/opt/market-data-gateway

# .env in WorkingDirectory drives everything. Compose reads it natively for both its own
# settings and variable interpolation, so the commands below need no flags:
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml   pull the published image
#                                                             instead of building here
#   COMPOSE_PROFILES=public                                   include Caddy (omit the
#                                                             line for a private instance)
#   GATEWAY_IMAGE=ghcr.io/<owner>/market-data-gateway:<tag>    what to run
#
# Keeping the profile and file list in .env rather than hard-coded here means a private
# instance and a public one use the identical unit file.
EnvironmentFile=-/opt/market-data-gateway/.env

ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

# `docker compose up -d` returns once containers are started, but the gateway waits on
# the broker's healthcheck before it begins. Give the whole stack room on a t3.micro,
# where a cold image pull plus JVM start is not fast.
TimeoutStartSec=600

# Restart the unit if the compose invocation itself fails. Individual container restarts
# are handled by `restart: unless-stopped` in the compose file.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
