target/
!.mvn/wrapper/maven-wrapper.jar

# NOTE: deploy/ and Makefile are deliberately TRACKED.
#
# deploy/ holds the Caddyfile, the systemd unit and the deployment guide. The CD
# pipeline clones this repo onto the instance and mounts ./deploy/Caddyfile into the
# Caddy container, so excluding it silently breaks deployment. It contains no secrets:
# every credential is a ${ENV_VAR} placeholder resolved from .env, which IS ignored.

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
nbproject/

# OS
.DS_Store
Thumbs.db

# Runtime
*.log
logs/

# Local overrides — never commit credentials or per-machine config
application-local.yml
application-local.properties
.env
.env.*
!.env.example

