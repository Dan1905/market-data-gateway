# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
#   cp .env.example .env && chmod 600 .env

# -----------------------------------------------------------------------------
# Public edge (only needed for `docker compose --profile public up`)
# -----------------------------------------------------------------------------

# Hostname Caddy serves. Must already resolve to this machine's public IP, or the
# Let's Encrypt challenge fails. Use ":80" for a local run with no TLS.
SITE_ADDRESS=gateway.example.com

GATEWAY_BASIC_AUTH_USER=admin

# BCRYPT HASH, never a plaintext password. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#
# If this is unset the edge fails closed — every request gets 401 — rather than
# silently running unauthenticated. POST /api/v1/dlq/replay has no application-level
# auth and republishes to a production topic, so that default matters.
GATEWAY_BASIC_AUTH_HASH=

# -----------------------------------------------------------------------------
# Local port overrides (optional)
# -----------------------------------------------------------------------------

# Change if something else already owns these on the host.
GATEWAY_PORT=8080
CONSOLE_PORT=8090

# -----------------------------------------------------------------------------
# Markets (optional; defaults are one BTC market per venue)
# -----------------------------------------------------------------------------

# Comma-separated, in each venue's own notation. All of a venue's symbols share one
# connection and are processed in parallel, each in its own ordered lane. More symbols
# means more CPU and topic disk, so on a t3.micro widen this a few at a time and watch
# `make ps` / the CPU credit balance.
# BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
# COINBASE_SYMBOLS=BTC-USD,ETH-USD
# KRAKEN_SYMBOLS=BTC/USD,ETH/USD
